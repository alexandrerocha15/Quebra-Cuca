@model QuebraCuca.WebApp.Modulos.ModuloCheque.ChequeViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cheque por Extenso";
}

<div class="container py-4">

    <h4 class="text-center mb-5">
        Digite um valor para vê-lo por extenso
    </h4>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <form asp-action="IndexCheque" method="post">

                        <div class="mb-4">

                            <label asp-for="Valor" class="form-label fw-semibold text-primary">
                                Valor
                            </label>

                            <input asp-for="Valor" class="form-control form-control-lg" type="number" step="0.01"
                                   placeholder="Digite o valor" />

                            <span asp-validation-for="Valor" class="text-danger">
                            </span>

                        </div>

                        <div asp-validation-summary="All" class="text-danger mb-3">
                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Home" asp-action="Index"
                               class="btn btn-outline-primary rounded-pill px-4">
                                Voltar
                            </a>

                            <button type="submit" class="btn btn-outline-primary rounded-pill px-4">
                                Gerar
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model?.ValorPorExtenso))
    {
        <div class="text-center mt-5">

            <h5 class="mb-3">
                Valor por extenso:
            </h5>

            <p class="fs-4">
                @Model.ValorPorExtenso
            </p>

        </div>
    }

</div>