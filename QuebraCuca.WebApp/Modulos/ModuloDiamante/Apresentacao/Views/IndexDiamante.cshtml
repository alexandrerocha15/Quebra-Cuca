@model QuebraCuca.WebApp.Modulos.ModuloDiamante.ViewModels.DiamanteViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Diamante";
}

<div class="container py-4">

    <h4 class="text-center mb-5">
        Digite um número Ímpar para formar um diamante
    </h4>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <form asp-action="IndexDiamante" method="post">

                        <div class="mb-4">

                            <label asp-for="Tamanho" 
                                class="form-label fw-semibold text-primary">
                                Tamanho do Diamante
                            </label>

                            <input asp-for="Tamanho"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Tamanho"
                                  class="text-danger">
                            </span>

                        </div>

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-primary rounded-pill px-4">
                                Voltar
                            </a>

                            <button type="submit"
                                    class="btn btn-outline-primary rounded-pill px-4">
                                Gerar
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

    @if (Model?.Linhas?.Any() == true)
    {
        <div class="text-center mt-5">

            <pre class="d-inline-block text-start border-0 bg-transparent fs-4">@Html.Raw(string.Join(Environment.NewLine, Model.Linhas))</pre>

        </div>
    }

</div>