@model QuebraCuca.WebApp.Modulos.ModuloDataHumanizada.DataHumanizadaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Data Humanizada";
}

<div class="container py-4">

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <p class="text-muted">
                Informe uma data para descobrir quanto tempo passou.
            </p>

            <p>
                <strong>A partir de:</strong>
                @Model.DataReferencia.ToString("dd/MM/yyyy HH:mm")
            </p>

            <form asp-controller="DataHumanizada"
                  asp-action="IndexDataHumanizada"
                  method="post">

                <input asp-for="DataReferencia" type="hidden" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Data" class="form-label">
                        Informe a data e a hora
                    </label>

                    <input asp-for="Data"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="Data"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary rounded-pill px-4">
                    Humanizar
                </button>

            </form>

            @if (!string.IsNullOrEmpty(Model.TextoHumanizado))
            {
                <div class="alert alert-success mt-4">
                    <strong>Resultado:</strong>
                    @Model.TextoHumanizado
                </div>
            }

        </div>
    </div>

</div>
