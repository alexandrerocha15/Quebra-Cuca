@model QuebraCuca.WebApp.Modulos.ModuloNumerosRomanos.NumerosRomanosViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Números Romanos";
}

<div class="container py-4">

    <h4 class="text-center mb-5">
        Converta números inteiros para romanos ou romanos para inteiros
    </h4>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <form asp-action="IndexNumerosRomanos" method="post">

                        <div class="mb-4">

                            <label asp-for="Entrada" class="form-label fw-semibold text-primary">
                                Número
                            </label>

                            <input asp-for="Entrada" class="form-control form-control-lg" placeholder="Ex: 14 ou XIV" />

                            <span asp-validation-for="Entrada" class="text-danger">
                            </span>

                        </div>

                        <div asp-validation-summary="All" class="text-danger mb-3">
                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Home" asp-action="Index"
                               class="btn btn-outline-primary rounded-pill px-4">
                                Voltar
                            </a>

                            <button type="submit" class="btn btn-outline-primary rounded-pill px-4">
                                Converter
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model?.Resultado))
    {
        <div class="text-center mt-5">

            @if (Model.Entrada.All(c => char.IsDigit(c)))
            {
                <h5 class="mb-3">
                    Em romanos:
                </h5>
            }
            else
            {
                <h5 class="mb-3">
                    Em números:
                </h5>
            }

            <p class="fs-4">
                @Model.Resultado
            </p>

        </div>
    }

</div>