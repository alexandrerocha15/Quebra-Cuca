@{
    Layout = "_Layout";
    ViewBag.Titulo = "Conversor de Números Romanos";
}
@model NumerosRomanosViewModel

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <h2 class="mb-4">Conversor de Números Romanos</h2>

            <p class="text-muted">
                Converta números inteiros para romanos ou números romanos para inteiros.
            </p>

            <form asp-action="IndexNumerosRomanos" method="post">

                <div class="mb-3">

                    <label asp-for="Entrada" class="form-label">
                        Número
                    </label>

                    <input asp-for="Entrada"
                           class="form-control"
                           placeholder="Ex: 14 ou XIV" />

                    <span asp-validation-for="Entrada"
                          class="text-danger"></span>

                </div>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Converter
                </button>

            </form>

            @if (!string.IsNullOrWhiteSpace(Model?.Resultado))
            {
                <div class="mt-4">

                    <h5>Resultado:</h5>

                    <p class="fs-4 fw-bold">
                        @Model.Resultado
                    </p>

                </div>
            }

        </div>
    </div>

</div>