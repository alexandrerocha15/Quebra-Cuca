@{
    Layout = "_Layout";
    ViewBag.Titulo = "Página Inicial";
}

<div class="row g-4">
    <div class="col-lg-7">
        <h1 class="display-5 fw-semibold mb-3">Quebra Cuca</h1>

        <p class="lead text-secondary mb-4">
            Quebra Cuca
        </p>
    </div>

    <div class="col-lg-5">
        <div class="card border-primary-subtle shadow-sm">
            <div class="card-body p-4">
                <h3 class="h5 text-primary mb-4">Desafios disponíveis</h3>

                <div class="row g-3">

                    <div class="col-12">
                        <div class="card border-primary">
                            <div class="card-body">
                                <h5 class="card-title mb-1">Diamante</h5>
                                <p class="card-text text-secondary small mb-0">
                                    Geração de padrões utilizando letras e espaçamento.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card border-warning">
                            <div class="card-body">
                                <h5 class="card-title mb-1">Cheque</h5>
                                <p class="card-text text-secondary small mb-0">
                                    Escrita de valores monetários por extenso.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card border-success">
                            <div class="card-body">
                                <h5 class="card-title mb-1">Romanos</h5>
                                <p class="card-text text-secondary small mb-0">
                                    Conversão entre números romanos e arábicos.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>